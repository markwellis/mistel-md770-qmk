 }
+
+#ifdef MD770_RECONNECT_DIAGNOSTICS
+void __attribute__((noinline, noclone)) md770_reconnect_diag(uint8_t page, uint8_t item, uint32_t values[7]) {
+    if (page == 32 || page == 33) md770_radio_select(item, page == 33);
+    if (page == 34) {
+        reconnect_trace_count = 0;
+        report_head = report_count = 0;
+        pending_command = COMMAND_USB_STATUS;
+        connection_set_host_noeeprom(CONNECTION_HOST_BLUETOOTH);
+        reset_radio();
+    }
+    if (page == 36) {
+        md770_radio_discard_reports();
+        report_keyboard_t empty = {0};
+        bluetooth_send_keyboard(&empty);
+        bluetooth_send_system(0);
+        bluetooth_send_consumer(0);
+    }
+    if (page >= 3 && page <= 6) {
+        memcpy(values, &reconnect_trace[page - 3], 28);
+    } else if (page == 1) {
+        values[0] = SPI0->SR;
+        values[1] = SPI0->FSR;
+        values[2] = SPI0->IER;
+        values[3] = SPI0->CR0;
+        values[4] = SPI0->CR1;
+        values[5] = SPI0->CPR;
+        values[6] = CKCU->APBCCR0;
+    } else if (page == 2) {
+        values[0] = connection_get_host_raw();
+        values[1] = connection_get_host();
+        values[2] = md770_power_usb_ready();
+        values[3] = USBD1.state;
+        values[4] = USBD1.configuration;
+        values[5] = gpio_read_pin(A10);
+        values[6] = gpio_read_pin(B12);
+    } else {
+        values[0] = timer_read32();
+        values[1] = phase;
+        values[2] = radio_state;
+        values[3] = pending_command;
+        values[4] = startup_attempts;
+        values[5] = report_count;
+        values[6] = reconnect_trace_count;
+    }
+}
+#endif
