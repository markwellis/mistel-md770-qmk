--- a/keyboards/mistel/md770rgb_bt/bluetooth.c
+++ b/keyboards/mistel/md770rgb_bt/bluetooth.c
@@ -42,6 +42,31 @@
 static bool                      held_armed;
 static volatile bool             stopped;
 
+#ifdef MD770_RECONNECT_DIAGNOSTICS
+static struct reconnect_trace {
+    uint32_t time;
+    uint8_t event, phase, state, command, tx_length, rx_length, attempts, queued;
+    uint16_t status;
+    uint8_t sent[7], received[7];
+} reconnect_trace[4];
+static uint32_t reconnect_trace_count;
+static volatile uint16_t reconnect_error_status;
+_Static_assert(sizeof(struct reconnect_trace) == 28, "Diagnostic frame must fit one Raw HID reply");
+
+static void reconnect_trace_event(uint8_t event) {
+    struct reconnect_trace *entry = &reconnect_trace[reconnect_trace_count++ % 4];
+    *entry = (struct reconnect_trace){.time = timer_read32(), .event = event, .phase = phase,
+        .state = radio_state, .command = pending_command, .tx_length = tx_length,
+        .rx_length = rx_length, .attempts = startup_attempts, .queued = report_count, .status = event == 3 && failed ? reconnect_error_status : SPI0->SR};
+    for (uint8_t i = 0; i < 7; ++i) {
+        entry->sent[i] = i < tx_length ? tx[i] : 0;
+        entry->received[i] = i < rx_length ? rx[i] : 0;
+    }
+}
+#else
+#    define reconnect_trace_event(event) ((void)0)
+#endif
+
 static bool receive_status(const uint8_t *data, uint8_t length);
 static void radio_task(void);
 
