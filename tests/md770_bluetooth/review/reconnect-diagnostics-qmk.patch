     OSAL_IRQ_PROLOGUE();
     if (!radio_suspended && (CKCU->APBCCR0 & CKCU_APBCCR0_SPI0EN) && (SPI0->CR0 & 1)) {
         if (SPI0->SR & 0xf8) {
+#ifdef MD770_RECONNECT_DIAGNOSTICS
+            reconnect_error_status = SPI0->SR;
+#endif
             failed    = true;
             SPI0->IER = 0;
             SPI0->SR  = 0xff;
