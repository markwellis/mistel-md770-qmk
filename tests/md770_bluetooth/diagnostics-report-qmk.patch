+#ifdef MD770_DIAGNOSTICS
+void md770_radio_snapshot(uint8_t page, uint32_t values[7]) {
+    switch (page) {
+        case 0:
+            values[0] = timer_read32();
+            values[1] = phase;
+            values[2] = radio_state;
+            values[3] = pending_slot;
+            values[4] = pair_requested;
+            values[5] = held_slot;
+            values[6] = count;
+            break;
+        case 1:
+            values[0] = SPI0->CR0;
+            values[1] = SPI0->CR1;
+            values[2] = SPI0->FCR;
+            values[3] = SPI0->SR;
+            values[4] = SPI0->FSR;
+            values[5] = SPI0->IER;
+            values[6] = rx_length | (uint32_t)selected << 8 | (uint32_t)failed << 9;
+            break;
+        case 2:
+            values[0] = GPIOA->DINR;
+            values[1] = GPIOB->DINR;
+            values[2] = GPIOC->DINR;
+            values[3] = GPIOC->DOUTR;
+            values[4] = GPIOD->DOUTR;
+            values[5] = GPIOC->INER;
+            values[6] = CKCU->APBCCR0;
+            break;
+        case 3:
+            values[0] = diagnostic_resets;
+            values[1] = diagnostic_irqs;
+            values[2] = diagnostic_tasks;
+            values[3] = diagnostic_profile_events;
+            values[4] = diagnostic_profile_code;
+            values[5] = phase_started;
+            values[6] = last_frame;
+            break;
+        case 4:
+            values[0] = connection_get_host();
+            values[1] = connection_get_host_raw();
+            values[2] = md770_charge_indicated();
+            values[3] = md770_power_idle();
+            values[4] = md770_power_usb_suspended();
+            values[5] = USBD1.configuration;
+            values[6] = GPIOB->INER;
+            break;
+        case 5:
+            values[0] = AFIO->GPxCFGR[0][0];
+            values[1] = AFIO->GPxCFGR[0][1];
+            values[2] = AFIO->GPxCFGR[1][0];
+            values[3] = AFIO->GPxCFGR[1][1];
+            values[4] = AFIO->GPxCFGR[2][1];
+            values[5] = AFIO->GPxCFGR[3][0];
+            values[6] = GPIOB->DIRCR;
+            break;
+        case 6:
+            values[0] = diagnostic_irq_status;
+            values[1] = diagnostic_irq_control;
+            values[2] = diagnostic_task_status;
+            values[3] = diagnostic_error_phase;
+            values[4] = SPI0->CPR;
+            values[5] = RSTCU->APBPRSTR0;
+            values[6] = SPI0->FTOCR;
+            break;
+        case 10:
+            values[0] = diagnostic_keyboard_calls;
+            values[1] = diagnostic_keyboard_drops;
+            values[2] = diagnostic_keyboard_state;
+            values[3] = diagnostic_keycode;
+            values[4] = diagnostic_key_position;
+            memcpy(values + 5, diagnostic_nonzero, 8);
+            break;
+        case 11:
+            values[0] = diagnostic_report_started;
+            values[1] = diagnostic_report_completed;
+            values[2] = diagnostic_last_rx;
+            values[3] = diagnostic_b7_count;
+            values[4] = current_command;
+            values[5] = current_length;
+            values[6] = tx_position | (uint32_t)tx_length << 8 | (uint32_t)rx_length << 16;
+            break;
+        case 12:
+            values[0] = diagnostic_test_mode;
+            values[1] = diagnostic_test_completed;
+            values[2] = diagnostic_test_started;
+            values[3] = diagnostic_test_released;
+            values[4] = count;
+            memcpy(values + 5, diagnostic_wire_nonzero, 8);
+            break;
+        case 7:
+            values[5] = diagnostic_profile_seen;
+            values[6] = diagnostic_profile_consumed;
+            break;
+    }
+}
+#endif
