+#ifdef MD770_DIAGNOSTICS
+static void diagnostic_report(bool pressed) {
+    uint8_t usage = diagnostic_test_mode == 2 ? KC_J : KC_A;
+    if (diagnostic_test_mode == 2) {
+        if (pressed) register_code(usage);
+        else unregister_code(usage);
+        return;
+    }
+    report_keyboard_t report = {0};
+    if (pressed) report.keys[0] = usage;
+    if (diagnostic_test_mode == 1) {
+        bluetooth_send_keyboard(&report);
+    } else if (count < QUEUE_SIZE) {
+        radio_packet_t *packet = &queue[(head + count) % QUEUE_SIZE];
+        memset(packet, 0, sizeof(*packet));
+        packet->data[0] = KEYBOARD;
+        packet->data[3] = pressed ? usage : 0;
+        packet->length = 9;
+        ++count;
+    }
+}
+
+bool md770_radio_test(uint8_t mode) {
+    if (mode < 1 || mode > 3 || diagnostic_test_mode || count) return false;
+    if (mode == 2) {
+        connection_set_host_noeeprom(CONNECTION_HOST_BLUETOOTH);
+        host_task();
+    }
+    diagnostic_test_mode = mode;
+    diagnostic_test_started = timer_read32();
+    diagnostic_test_released = false;
+    diagnostic_report(true);
+    return true;
+}
+#endif
+
 void bluetooth_task(void) {
+#ifdef MD770_DIAGNOSTICS
+    ++diagnostic_tasks;
+    if (diagnostic_test_mode) {
+        if (!diagnostic_test_released && timer_elapsed32(diagnostic_test_started) >= 200 && count < QUEUE_SIZE) {
+            diagnostic_report(false);
+            diagnostic_test_released = true;
+        }
+        if (diagnostic_test_released && !count && phase == READY) {
+            diagnostic_test_mode = 0;
+            ++diagnostic_test_completed;
+        }
+    }
+#endif
     if (stopped) {
         return;
     }
@@ -402,3 +523,102 @@
     chSysUnlock();
     stopped = true;
 }
